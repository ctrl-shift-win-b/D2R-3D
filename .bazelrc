# Windows/MSVC x64 only, by design (D2R is x64).
#   bazel build //...
# Outputs: bazel-bin/standalone/dist/d2r-3d.{exe,dll} -> D2R folder
#          bazel-bin/plugin/d2rl-*.dll     -> <D2R>\d2rloader\plugins\

build --compilation_mode=opt
build --features=static_link_msvcrt   # /MT: no VC++ redistributable needed
# Replace the toolchain's default /std:c++17.
build --features=-default_cpp_std
build --cxxopt=/std:c++20
