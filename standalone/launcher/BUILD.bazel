load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

# Own package only because exe and dll share the base name "d2r-3d": in one package
# their d2r-3d.pdb outputs collide (-c dbg).
cc_binary(
    name = "d2r-3d",  # -> d2r-3d.exe
    srcs = ["launcher.cpp"],
    copts = [
        "/utf-8",
        "/W3",
        "/EHsc",
        "/permissive-",
    ],
    local_defines = [
        "UNICODE",
        "_UNICODE",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//standalone:__pkg__"],
)
